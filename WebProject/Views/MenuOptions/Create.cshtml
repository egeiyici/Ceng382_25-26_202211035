@model WebProject.Models.MenuOption

@{
    ViewData["Title"] = "Add Catering Package Feature";
}

<h1>Add Catering Package Feature</h1>

<div class="card-box">

    <p>
        <strong>Selected Catering Package:</strong>
        @ViewBag.MenuItemName
    </p>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="MenuItemId"
               value="@ViewBag.MenuItemId" />

        <div class="form-group-clean">

            <label asp-for="OptionName">
                Feature / Additional Service
            </label>

            <input asp-for="OptionName"
                   placeholder="Example: Extra desserts, live grill station, unlimited drinks, VIP table setup" />

            <span asp-validation-for="OptionName"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group-clean">

            <label asp-for="ExtraPrice">
                Additional Service Price
            </label>

            <input asp-for="ExtraPrice"
                   type="number"
                   step="0.01"
                   placeholder="250" />

            <span asp-validation-for="ExtraPrice"
                  class="text-danger">
            </span>

            <small>
                Enter 0 for free selectable options.
            </small>

        </div>

        <div style="margin-top:25px; display:flex; gap:12px;">

            <button type="submit">
                Add Feature
            </button>

            <a class="action-link"
               asp-controller="MenuItems"
               asp-action="Index">

                Back to Packages

            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}