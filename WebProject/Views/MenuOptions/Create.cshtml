@model WebProject.Models.MenuOption

@{
    ViewData["Title"] = "Create Menu Option";
}

<h1>Add Customization Option</h1>

<p><strong>Menu Item:</strong> @ViewBag.MenuItemName</p>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="MenuItemId" value="@ViewBag.MenuItemId" />

    <div>
        <label asp-for="OptionName"></label>
        <input asp-for="OptionName" />
        <span asp-validation-for="OptionName"></span>
    </div>

    <div>
        <label asp-for="ExtraPrice"></label>
        <input asp-for="ExtraPrice" type="number" step="0.01" />
        <span asp-validation-for="ExtraPrice"></span>
    </div>

    <button type="submit">Save Option</button>
</form>

<a asp-controller="MenuItems" asp-action="Index">Back to Menu List</a>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}