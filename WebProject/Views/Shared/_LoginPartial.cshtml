@using Microsoft.AspNetCore.Identity
@using WebProject.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="login-area">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
            ? currentUser.FullName
            : currentUser?.Email;

        <span class="login-text">
            Hello, @displayName
        </span>

        <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    }
    else
    {
        <a class="login-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="login-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    }
</div>