<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Food4Everyone</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="page-shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand-box">
                <div class="brand-logo">F4E</div>

                

                <p>
                    Smart catering platform<br />
                    for companies and events
                </p>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="MenuItems" asp-action="Index">All Catering Packages</a>

                @if (User.IsInRole("User"))
                {
                    <a asp-controller="Cart" asp-action="Index">Selected Packages</a>
                    <a asp-controller="Orders" asp-action="MyOrders">My Catering Orders</a>
                    <a asp-controller="Addresses" asp-action="Index">Delivery Addresses</a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a>
                }

                @if (User.IsInRole("Caretaker"))
{
    <a asp-controller="MenuItems" asp-action="Create">
        Create Catering Package
    </a>

    <a asp-controller="MenuItems" asp-action="Index">
        My Packages
    </a>

    <a asp-controller="Orders" asp-action="CaretakerOrders">
        Received Orders
    </a>

    <a asp-area="Identity"
       asp-page="/Account/Manage/Index">
        Company Profile
    </a>
}

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminLogs" asp-action="Index">System Logs</a>
                    <a asp-controller="AdminUsers" asp-action="Index">Users & Catering Companies</a>
                    <a asp-controller="Orders" asp-action="AdminOrders">All Catering Orders</a>
                }
            </nav>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button id="menuToggle" type="button">☰</button>
                    <span class="logo-text">Food4Everyone</span>
                </div>

                <div class="topbar-right">
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>

            <footer class="footer premium-footer">
                <div>
                    <strong>Food4Everyone</strong>
                    <p>
                        Catering package marketplace for nearby companies,
                        event orders, secure payments, and order support.
                    </p>
                </div>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="About">About</a>
                    <a asp-controller="Home" asp-action="Index">Catering Companies</a>
                    <a asp-controller="MenuItems" asp-action="Index">Packages</a>
                    <span>© 2026</span>
                </div>
            </footer>
        </div>
    </div>

    <script>
        const toggleBtn = document.getElementById("menuToggle");
        const sidebar = document.getElementById("sidebar");

        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener("click", () => {
                sidebar.classList.toggle("collapsed");
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>