@using WebProject.Models

@{
    ViewData["Title"] = "Catering Company Dashboard";

    var recentMessages = ViewBag.RecentMessages as List<OrderMessage>;
    var recentOrderItems = ViewBag.RecentOrderItems as List<OrderItem>;
}

<h1>Catering Company Dashboard</h1>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h3>Received Orders</h3>
        <p>@ViewBag.TotalReceivedOrders</p>
    </div>

    <div class="dashboard-card">
        <h3>Completed Orders</h3>
        <p>@ViewBag.CompletedOrders</p>
    </div>

    <div class="dashboard-card">
        <h3>Total Revenue</h3>
        <p>@ViewBag.TotalRevenue ₺</p>
    </div>

    <div class="dashboard-card">
    <h3>Average Package Rating</h3>

    @{
        double averageRating = ViewBag.AverageGivenMenuRating != null
            ? Convert.ToDouble(ViewBag.AverageGivenMenuRating)
            : 0;
    }

    <p>⭐ @averageRating.ToString("0.0")</p>
</div>
    <div class="dashboard-card">
        <h3>Catering Packages</h3>
        <p>@ViewBag.MenuItemCount</p>
    </div>
</div>

<div class="card-box">
    <h2>Recent Catering Orders</h2>

    @if (recentOrderItems == null || !recentOrderItems.Any())
    {
        <p>No recent catering orders.</p>
    }
    else
    {
        <table style="width:100%; background:white; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="padding:10px; border:1px solid #ddd;">Order ID</th>
                    <th style="padding:10px; border:1px solid #ddd;">Customer</th>
                    <th style="padding:10px; border:1px solid #ddd;">Catering Package</th>
                    <th style="padding:10px; border:1px solid #ddd;">Quantity</th>
                    <th style="padding:10px; border:1px solid #ddd;">Total</th>
                    <th style="padding:10px; border:1px solid #ddd;">Support</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in recentOrderItems)
                {
                    <tr>
                        <td style="padding:10px; border:1px solid #ddd;">#@item.OrderId</td>
                        <td style="padding:10px; border:1px solid #ddd;">@item.Order?.User?.Email</td>
                        <td style="padding:10px; border:1px solid #ddd;">@item.MenuItem?.Name</td>
                        <td style="padding:10px; border:1px solid #ddd;">@item.Quantity</td>
                        <td style="padding:10px; border:1px solid #ddd;">@item.LineTotal.ToString("0.00") ₺</td>
                        <td style="padding:10px; border:1px solid #ddd;">
                            <a asp-controller="Support" asp-action="Chat" asp-route-orderId="@item.OrderId">Open Chat</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card-box">
    <h2>Recent Support Messages</h2>

    @if (recentMessages == null || !recentMessages.Any())
    {
        <p>No recent support messages.</p>
    }
    else
    {
        @foreach (var msg in recentMessages)
        {
            <div style="padding:10px; border-bottom:1px solid #ddd;">
                <strong>@msg.Sender?.FullName</strong>
                <p>@msg.MessageText</p>
                <small>Catering Order #@msg.OrderId - @msg.SentAt</small>
            </div>
        }
    }
</div>

<a class="action-link" asp-controller="MenuItems" asp-action="Index">Manage Catering Packages</a>
<a class="action-link" asp-controller="Orders" asp-action="CaretakerOrders">Received Catering Orders</a>    