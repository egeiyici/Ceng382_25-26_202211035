@using WebProject.Models

@{
    ViewData["Title"] = "Admin Dashboard";
    var latestOrders = ViewBag.LatestOrders as List<Order>;
}

<h1>Admin Dashboard</h1>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h3>Total Customers</h3>
        <p>@ViewBag.TotalUsers</p>
    </div>

    <div class="dashboard-card">
        <h3>Catering Companies</h3>
        <p>@ViewBag.TotalCaretakers</p>
    </div>

    <div class="dashboard-card">
        <h3>Catering Orders</h3>
        <p>@ViewBag.TotalOrders</p>
    </div>

    <div class="dashboard-card">
        <h3>Total Revenue</h3>
        <p>@ViewBag.TotalRevenue ₺</p>
    </div>

    <div class="dashboard-card">
        <h3>System Logs</h3>
        <p>@ViewBag.TotalLogs</p>
    </div>

    <div class="dashboard-card">
        <h3>Catering Packages</h3>
        <p>@ViewBag.TotalMenuItems</p>
    </div>
</div>

<div class="card-box">
    <h2>Latest Catering Orders</h2>

    @if (latestOrders == null || !latestOrders.Any())
    {
        <p>No recent catering orders.</p>
    }
    else
    {
        <table style="width:100%; background:white; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="padding:10px; border:1px solid #ddd;">Order ID</th>
                    <th style="padding:10px; border:1px solid #ddd;">Customer</th>
                    <th style="padding:10px; border:1px solid #ddd;">Date</th>
                    <th style="padding:10px; border:1px solid #ddd;">Total</th>
                    <th style="padding:10px; border:1px solid #ddd;">Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in latestOrders)
                {
                    <tr>
                        <td style="padding:10px; border:1px solid #ddd;">#@order.Id</td>
                        <td style="padding:10px; border:1px solid #ddd;">@order.User?.Email</td>
                        <td style="padding:10px; border:1px solid #ddd;">@order.CreatedAt</td>
                        <td style="padding:10px; border:1px solid #ddd;">@order.TotalPrice.ToString("0.00") ₺</td>
                        <td style="padding:10px; border:1px solid #ddd;">@order.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a class="action-link" asp-controller="AdminLogs" asp-action="Index">View System Logs</a>
<a class="action-link" asp-controller="AdminUsers" asp-action="Index">Users & Catering Companies</a>
<a class="action-link" asp-controller="Orders" asp-action="AdminOrders">All Catering Orders</a>