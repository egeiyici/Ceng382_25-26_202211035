@model List<WebProject.Models.RestaurantViewModel>

@{
    ViewData["Title"] = "Home";

    var allCateringCompanies =
        ViewBag.AllCateringCompanies as List<WebProject.Models.RestaurantViewModel>
        ?? new List<WebProject.Models.RestaurantViewModel>();
}

<section class="hero-section">
    <div class="hero-content">
        <span class="hero-badge">Food4Everyone Catering Platform</span>

        <h1>Professional catering companies for events, offices, and organizations.</h1>

        <p>
            Discover nearby catering companies, compare catering packages,
            customize service options, place bulk orders,
            and communicate with your caterer after purchase.
        </p>

        <div class="hero-actions">
            <a class="hero-primary" href="#nearby-catering-companies">
                Explore Nearby Companies
            </a>

            <a class="hero-secondary" href="#all-catering-companies">
                View All Ankara Companies
            </a>

            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a class="hero-secondary"
                   asp-area="Identity"
                   asp-page="/Account/Register">
                    Register as a Caterer
                </a>
            }
        </div>
    </div>

    <div class="hero-panel">
        <div class="hero-food-card">
            <div class="hero-icon">🥗</div>

            <h3>Smart Catering Orders</h3>

            <p>
                Location-based company filtering, customizable catering packages,
                simulated payments, dynamic agreements, and order-based support.
            </p>
        </div>
    </div>
</section>

<section class="stats-strip">
    <div>
        <strong>1200+</strong>
        <span>Demo Catering Orders</span>
    </div>

    <div>
        <strong>45+</strong>
        <span>Partner Catering Firms</span>
    </div>

    <div>
        <strong>4.8</strong>
        <span>Average Company Rating</span>
    </div>

    <div>
        <strong>24/7</strong>
        <span>Order Support Chat</span>
    </div>
</section>

<section class="why-section">
    <h2>Why Food4Everyone?</h2>

    <div class="why-grid">
        <div class="why-card">
            <span>📍</span>

            <h3>Nearby Catering Companies</h3>

            <p>
                Users can discover catering companies close to their selected delivery address
                through Google Maps-based filtering.
            </p>
        </div>

        <div class="why-card">
            <span>📦</span>

            <h3>Customizable Packages</h3>

            <p>
                Caterers can offer dynamic catering packages with optional additions,
                removable items, service extras, and price-changing options.
            </p>
        </div>

        <div class="why-card">
            <span>🧾</span>

            <h3>Dynamic Documents</h3>

            <p>
                Every completed order can generate a receipt and agreement PDF
                using real customer, caterer, package, and payment data.
            </p>
        </div>

        <div class="why-card">
            <span>💬</span>

            <h3>Order-Based Support</h3>

            <p>
                Customers and catering companies can communicate after purchase
                through an order-linked support chat system.
            </p>
        </div>
    </div>
</section>

<section id="nearby-catering-companies" class="restaurant-section">

    <div class="section-heading">
        <div>
            <h1>Nearby Catering Companies</h1>

            @if (ViewBag.LocationFilterMessage != null)
            {
                <p>@ViewBag.LocationFilterMessage</p>
            }
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <h2>No nearby catering companies found</h2>

            <p>
                The 10 km filter did not find a nearby company.
                You can still choose any Ankara catering company below.
            </p>
        </div>
    }
    else
    {
        <div class="restaurant-grid">
            @foreach (var restaurant in Model)
            {
                <div class="restaurant-card">
                    <div class="restaurant-cover">
                        <div class="restaurant-initial">
                            @restaurant.RestaurantName.Substring(0, 1)
                        </div>
                    </div>

                    <div class="restaurant-body">
                        <h2>@restaurant.RestaurantName</h2>

                        <p class="restaurant-address">
                            <strong>Service Address:</strong>
                            @restaurant.Address
                        </p>

                        <div class="restaurant-stats">
                            <span>
                                ⭐ @restaurant.AverageRating.ToString("0.0")
                            </span>

                            <span>
                                @restaurant.MenuItemCount catering packages
                            </span>

                            @if (restaurant.DistanceKm != null)
                            {
                                <span>
                                    @restaurant.DistanceKm.Value.ToString("0.0") km away
                                </span>
                            }
                        </div>

                        <div class="restaurant-actions">
                            @if (!string.IsNullOrWhiteSpace(restaurant.Address))
                            {
                                <a class="map-pill"
                                   href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(restaurant.Address)"
                                   target="_blank">
                                    View on Maps
                                </a>
                            }

                            <a class="view-menu-pill"
                               asp-controller="MenuItems"
                               asp-action="Index"
                               asp-route-caretakerId="@restaurant.CaretakerId">
                                View Packages
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section id="all-catering-companies" class="restaurant-section">

    <div class="section-heading">
        <div>
            <h1>All Catering Companies in Ankara</h1>

            <p>
                These companies are available for demo purposes and are not limited by the 10 km nearby filter.
            </p>
        </div>
    </div>

    @if (!allCateringCompanies.Any())
    {
        <div class="empty-state">
            <h2>No catering companies found</h2>

            <p>
                Create catering company accounts and packages to display them here.
            </p>
        </div>
    }
    else
    {
        <div class="restaurant-grid">
            @foreach (var restaurant in allCateringCompanies)
            {
                <div class="restaurant-card">
                    <div class="restaurant-cover">
                        <div class="restaurant-initial">
                            @restaurant.RestaurantName.Substring(0, 1)
                        </div>
                    </div>

                    <div class="restaurant-body">
                        <h2>@restaurant.RestaurantName</h2>

                        <p class="restaurant-address">
                            <strong>Service Address:</strong>
                            @restaurant.Address
                        </p>

                        <div class="restaurant-stats">
                            <span>
                                ⭐ @restaurant.AverageRating.ToString("0.0")
                            </span>

                            <span>
                                @restaurant.MenuItemCount catering packages
                            </span>
                        </div>

                        <div class="restaurant-actions">
                            @if (!string.IsNullOrWhiteSpace(restaurant.Address))
                            {
                                <a class="map-pill"
                                   href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(restaurant.Address)"
                                   target="_blank">
                                    View on Maps
                                </a>
                            }

                            <a class="view-menu-pill"
                               asp-controller="MenuItems"
                               asp-action="Index"
                               asp-route-caretakerId="@restaurant.CaretakerId">
                                View Packages
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>