@{
    ViewData["Title"] = "About";
}

<section class="about-hero">
    <span class="hero-badge">About Food4Everyone</span>

    <h1>Connecting customers with nearby catering companies through a smart ordering platform.</h1>

    <p>
        Food4Everyone is a full-stack catering marketplace designed for location-based catering company discovery,
        customizable catering package ordering, simulated payments, dynamic document generation,
        ratings, logging, and order-based communication.
    </p>
</section>

<section class="about-grid">
    <div class="about-card">
        <h2>Our Mission</h2>
        <p>
            To make event, office, and organization catering more accessible, transparent, and manageable
            by connecting customers with trusted catering companies close to their selected delivery address.
        </p>
    </div>

    <div class="about-card">
        <h2>For Customers</h2>
        <p>
            Customers can browse nearby catering companies, compare catering packages, select package options,
            place orders, complete simulated payments, download receipts, and contact caterers after purchase.
        </p>
    </div>

    <div class="about-card">
        <h2>For Catering Companies</h2>
        <p>
            Caterers can create catering packages, define dynamic package options, upload package images,
            manage received orders, review customer activity, and respond to support messages.
        </p>
    </div>

    <div class="about-card">
        <h2>For Admins</h2>
        <p>
            Admins can monitor system logs, inspect users and catering companies, review orders,
            and track important platform activity.
        </p>
    </div>
</section>

<section class="tech-section">
    <h2>Core System Features</h2>

    <div class="tech-list">
        <span>Role-Based Authorization</span>
        <span>Google Maps Filtering</span>
        <span>Catering Package Management</span>
        <span>Cart & Payment Simulation</span>
        <span>Dynamic Receipt Generation</span>
        <span>Dynamic Agreement PDF</span>
        <span>Email Notifications</span>
        <span>Order Support Chat</span>
        <span>Two-Factor Authentication</span>
        <span>System Logging</span>
    </div>
</section>