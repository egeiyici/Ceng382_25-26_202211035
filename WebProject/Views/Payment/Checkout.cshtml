@model WebProject.Models.PaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<h1>Payment Simulation</h1>

<h2>Order Summary</h2>

<table style="width:100%; background:white; border-collapse:collapse; margin-bottom:20px;">
    <thead>
        <tr>
            <th style="padding:10px; border:1px solid #ddd;">Item</th>
            <th style="padding:10px; border:1px solid #ddd;">Options</th>
            <th style="padding:10px; border:1px solid #ddd;">Quantity</th>
            <th style="padding:10px; border:1px solid #ddd;">Line Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CartItems)
        {
            <tr>
                <td style="padding:10px; border:1px solid #ddd;">@item.MenuItemName</td>
                <td style="padding:10px; border:1px solid #ddd;">
                    @if (item.SelectedOptionNames.Any())
                    {
                        @string.Join(", ", item.SelectedOptionNames)
                    }
                    else
                    {
                        <span>No customization</span>
                    }
                </td>
                <td style="padding:10px; border:1px solid #ddd;">@item.Quantity</td>
                <td style="padding:10px; border:1px solid #ddd;">@item.LineTotal ₺</td>
            </tr>
        }
    </tbody>
</table>

<h3>Total: @Model.TotalPrice ₺</h3>

<form asp-action="Checkout" method="post">
    <div>
        <label asp-for="CardHolderName"></label>
        <input asp-for="CardHolderName" />
        <span asp-validation-for="CardHolderName"></span>
    </div>

    <div>
        <label asp-for="CardNumber"></label>
        <input asp-for="CardNumber" />
        <span asp-validation-for="CardNumber"></span>
    </div>

    <div>
        <label asp-for="ExpirationDate"></label>
        <input asp-for="ExpirationDate" placeholder="MM/YY" />
        <span asp-validation-for="ExpirationDate"></span>
    </div>

    <div>
        <label asp-for="CVV"></label>
        <input asp-for="CVV" />
        <span asp-validation-for="CVV"></span>
    </div>

    <button type="submit">Complete Payment</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}