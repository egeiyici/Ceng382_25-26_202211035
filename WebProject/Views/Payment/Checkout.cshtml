@model WebProject.Models.PaymentViewModel

@{
    ViewData["Title"] = "Catering Payment";
}

<h1>Catering Payment</h1>

<div class="payment-layout">
    <div class="payment-summary-card">
        <h2>Order Summary</h2>

        <p>
            Review your selected catering packages, guest count,
            and package features before completing the simulated payment.
        </p>

        <div class="payment-package-list">
            @foreach (var item in Model.CartItems)
            {
                <div class="payment-package-row">
                    <div>
                        <h3>@item.MenuItemName</h3>

                        <p>
                            <strong>People:</strong> @item.PersonCount
                        </p>

                        <p>
                            <strong>Base Package:</strong>
                            @item.UnitPrice.ToString("0.00") ₺
                        </p>

                        <p>
                            <strong>Dynamic Package Total:</strong>
                            @item.PackageBaseTotal.ToString("0.00") ₺
                        </p>

                        @if (item.SelectedOptionNames.Any())
                        {
                            <p>
                                <strong>Selected Features:</strong>
                                @string.Join(", ", item.SelectedOptionNames)
                            </p>
                        }
                        else
                        {
                            <p>No additional package features selected.</p>
                        }

                        <span>Quantity: @item.Quantity</span>
                    </div>

                    <strong>@item.LineTotal.ToString("0.00") ₺</strong>
                </div>
            }
        </div>

        <div class="payment-total">
            <span>Total Catering Order</span>
            <strong>@Model.TotalPrice.ToString("0.00") ₺</strong>
        </div>
    </div>

    <div class="payment-form-card">
        <h2>Payment Simulation</h2>

        <p>
            This is a demo payment screen. No real card transaction is processed.
        </p>

        <form asp-action="Checkout" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group-clean">
                <label asp-for="CardHolderName">Card Holder Name</label>
                <input asp-for="CardHolderName" placeholder="Demo User" />
                <span asp-validation-for="CardHolderName" class="text-danger"></span>
            </div>

            <div class="form-group-clean">
                <label asp-for="CardNumber">Card Number</label>
                <input asp-for="CardNumber" placeholder="4111111111111111" maxlength="16" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
            </div>

            <div class="payment-mini-grid">
                <div class="form-group-clean">
                    <label asp-for="ExpirationDate">Expiration Date</label>
                    <input asp-for="ExpirationDate" placeholder="12/28" maxlength="5" />
                    <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                </div>

                <div class="form-group-clean">
                    <label asp-for="CVV">CVV</label>
                    <input asp-for="CVV" placeholder="123" maxlength="3" />
                    <span asp-validation-for="CVV" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="cart-button">
                Complete Catering Payment
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}