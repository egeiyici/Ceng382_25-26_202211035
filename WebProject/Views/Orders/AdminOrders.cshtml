@model List<WebProject.Models.Order>

@{
    ViewData["Title"] = "Admin Catering Orders";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<h1>Admin Catering Orders</h1>

<div class="card-box">
    <form method="get">
        <input type="text"
               name="searchTerm"
               value="@searchTerm"
               placeholder="Search catering orders..." />

        <button type="submit">Filter</button>
        <a class="action-link" asp-action="AdminOrders">Clear</a>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>No catering orders found</h2>
        <p>Completed catering package orders will appear here.</p>
    </div>
}
else
{
    <table style="width:100%; background:white; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="padding:10px; border:1px solid #ddd;">Order ID</th>
                <th style="padding:10px; border:1px solid #ddd;">Customer</th>
                <th style="padding:10px; border:1px solid #ddd;">Date</th>
                <th style="padding:10px; border:1px solid #ddd;">Status</th>
                <th style="padding:10px; border:1px solid #ddd;">Total</th>
                <th style="padding:10px; border:1px solid #ddd;">Packages</th>
                <th style="padding:10px; border:1px solid #ddd;">Documents</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td style="padding:10px; border:1px solid #ddd;">@order.Id</td>
                    <td style="padding:10px; border:1px solid #ddd;">@order.User?.Email</td>
                    <td style="padding:10px; border:1px solid #ddd;">@order.CreatedAt</td>
                    <td style="padding:10px; border:1px solid #ddd;">@order.Status</td>
                    <td style="padding:10px; border:1px solid #ddd;">@order.TotalPrice.ToString("0.00") ₺</td>
                    <td style="padding:10px; border:1px solid #ddd;">
                        @foreach (var item in order.OrderItems)
                        {
                            <div>@item.MenuItem?.Name x @item.Quantity</div>
                        }
                    </td>
                    <td style="padding:10px; border:1px solid #ddd;">
                        <a asp-controller="Documents" asp-action="Receipt" asp-route-orderId="@order.Id">Receipt</a>
                        |
                        <a asp-controller="Documents" asp-action="Agreement" asp-route-orderId="@order.Id">Agreement</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card-box" style="margin-top:20px;">
        @if (currentPage > 1)
        {
            <a class="action-link"
               asp-action="AdminOrders"
               asp-route-page="@(currentPage - 1)"
               asp-route-searchTerm="@searchTerm">
                Previous
            </a>
        }

        <span style="margin:0 10px;">Page @currentPage of @totalPages</span>

        @if (currentPage < totalPages)
        {
            <a class="action-link"
               asp-action="AdminOrders"
               asp-route-page="@(currentPage + 1)"
               asp-route-searchTerm="@searchTerm">
                Next
            </a>
        }
    </div>
}