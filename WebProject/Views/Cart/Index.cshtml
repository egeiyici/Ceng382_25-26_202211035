@model List<WebProject.Models.CartItem>

@using Microsoft.AspNetCore.Identity
@inject UserManager<WebProject.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Selected Catering Packages";

    decimal total = Model.Sum(x => x.LineTotal);

    var currentUser = await UserManager.GetUserAsync(User);

    var hasAddress =
        currentUser != null &&
        !string.IsNullOrWhiteSpace(currentUser.Address);
}

<h1>Selected Catering Packages</h1>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>Your catering cart is empty</h2>
        <p>Select a catering package from a company to start your order.</p>
    </div>
}
else
{
    <div class="cart-package-list">
        @foreach (var item in Model)
        {
            <div class="cart-package-card">

                <div class="cart-package-main">
                    <div>
                        <h2>@item.MenuItemName</h2>

                        <p>
                            <strong>Guest Count:</strong>
                            @item.PersonCount person(s)
                        </p>

                        @if (item.SelectedOptionNames.Any())
                        {
                            <p>
                                <strong>Selected package features:</strong>
                                @string.Join(", ", item.SelectedOptionNames)
                            </p>
                        }
                        else
                        {
                            <p>No additional package features selected.</p>
                        }
                    </div>

                    <div class="cart-package-price">
                        @item.LineTotal.ToString("0.00") ₺
                    </div>
                </div>

                <div class="cart-package-details">
                    <span>
                        Base Package:
                        @item.BasePrice.ToString("0.00") ₺
                    </span>

                    <span>
                        Minimum Guests:
                        @item.MinimumPeople
                    </span>

                    <span>
                        Extra Guest Price:
                        @item.PricePerExtraPerson.ToString("0.00") ₺
                    </span>

                    <span>
                        Dynamic Guest Price:
                        @item.PackageBaseTotal.ToString("0.00") ₺
                    </span>

                    <span>
                        Features Total:
                        @item.CustomizationTotal.ToString("0.00") ₺
                    </span>
                </div>

                <div class="cart-package-actions">
                    <form asp-controller="Cart"
                          asp-action="Remove"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="menuItemId"
                               value="@item.MenuItemId" />

                        <button type="submit"
                                class="danger-button">
                            Remove Package
                        </button>
                    </form>
                </div>

            </div>
        }
    </div>

    <div class="cart-summary-card">
        <div>
            <h2>Total Catering Order</h2>
            <p>
                Group-size pricing and selected package features are included.
            </p>

            @if (hasAddress)
            {
                <div class="current-address-box" style="margin-top:14px;">
                    <strong>Selected Delivery Address:</strong>
                    <span>@currentUser!.Address</span>
                </div>
            }
            else
            {
                <div class="current-address-box" style="margin-top:14px;">
                    <strong>No delivery address selected.</strong>
                    <span>Please add a delivery address before payment.</span>
                </div>
            }
        </div>

        <div class="cart-summary-right">
            <strong>@total.ToString("0.00") ₺</strong>

            @if (hasAddress)
            {
                <a class="action-link cart-button"
                   asp-controller="Payment"
                   asp-action="Checkout">
                    Continue to Payment
                </a>

                <a class="action-link"
                   asp-controller="Addresses"
                   asp-action="Index"
                   asp-route-returnUrl="/Cart">
                    Change Address
                </a>
            }
            else
            {
                <a class="action-link"
                   asp-controller="Addresses"
                   asp-action="Index"
                   asp-route-returnUrl="/Cart">
                    Add Delivery Address
                </a>
            }
        </div>
    </div>
}