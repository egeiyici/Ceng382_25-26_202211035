@model IEnumerable<WebProject.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Items";
}

<h1>Menu Items</h1>

<p>
    <a asp-action="Create">Create New Menu Item</a>
</p>

<table style="width:100%; background:white; border-collapse:collapse;">
    <thead>
        <tr>
            <th style="padding:10px; border:1px solid #ddd;">Name</th>
            <th style="padding:10px; border:1px solid #ddd;">Price</th>
            <th style="padding:10px; border:1px solid #ddd;">Rating</th>
            <th style="padding:10px; border:1px solid #ddd;">Description</th>
            <th style="padding:10px; border:1px solid #ddd;">Caretaker</th>
            <th style="padding:10px; border:1px solid #ddd;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var averageRating = item.Ratings != null && item.Ratings.Any()
                ? item.Ratings.Average(r => r.Score)
                : 0;

            <tr>
                <td style="padding:10px; border:1px solid #ddd;">@item.Name</td>
                <td style="padding:10px; border:1px solid #ddd;">@item.Price ₺</td>
                <td style="padding:10px; border:1px solid #ddd;">⭐ @averageRating.ToString("0.0")</td>
                <td style="padding:10px; border:1px solid #ddd;">@item.Description</td>
                <td style="padding:10px; border:1px solid #ddd;">@item.Caretaker?.Email</td>
                <td style="padding:10px; border:1px solid #ddd;">
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-controller="MenuOptions" asp-action="Create" asp-route-menuItemId="@item.Id">Add Option</a>
                </td>
            </tr>
        }
    </tbody>
</table>