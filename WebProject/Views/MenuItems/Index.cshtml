@model IEnumerable<WebProject.Models.MenuItem>

@{
    ViewData["Title"] = "Catering Packages";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="restaurant-menu-header">
    <div>
        <h2>Catering Packages</h2>

        <p>
            Browse available catering packages, event meal plans,
            and customizable service options.
        </p>
    </div>

    <form method="get">
        <input type="hidden"
               name="caretakerId"
               value="@Context.Request.Query["caretakerId"]" />

        <input type="text"
               name="searchTerm"
               value="@searchTerm"
               placeholder="Search catering package..." />

        <button type="submit">
            Search
        </button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>No catering packages found</h2>

        <p>
            This catering company has not published any packages yet.
        </p>
    </div>
}
else
{
    <div class="restaurant-food-grid">
        @foreach (var item in Model)
        {
            var averageRating =
                item.Ratings != null && item.Ratings.Any()
                    ? item.Ratings.Average(r => r.Score)
                    : 0;

            <div class="restaurant-food-card">
                <div class="restaurant-food-image-wrapper">
                    @if (item.ImageData != null)
                    {
                        <img class="restaurant-food-image"
                             src="@Url.Action("Image", "MenuItems", new { id = item.Id })" />
                    }
                    else
                    {
                        <div class="restaurant-food-placeholder">
                            📦
                        </div>
                    }

                    <div class="restaurant-food-price">
                        @item.BasePrice.ToString("0.00") ₺
                    </div>
                </div>

                <div class="restaurant-food-content">
                    <div class="restaurant-food-top">
                        <h2>@item.Name</h2>

                        <span class="restaurant-food-rating">
                            ⭐ @averageRating.ToString("0.0")
                        </span>
                    </div>

                    <p class="restaurant-food-description">
                        @item.Description
                    </p>

                    <div class="restaurant-food-tags">
                        <span>🎉 Event Catering</span>
                        <span>📦 Custom Package</span>
                        <span>👥 Min @item.MinimumPeople people</span>
                    </div>

                    <div class="restaurant-food-bottom">
                        @if (User.IsInRole("User"))
                        {
                            <a class="restaurant-cart-button"
                               asp-controller="Cart"
                               asp-action="Details"
                               asp-route-menuItemId="@item.Id">
                                Customize Package
                            </a>
                        }

                        @if (User.IsInRole("Caretaker"))
                        {
                            <div class="menu-actions">
                                <a class="restaurant-cart-button"
                                   asp-controller="MenuItems"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id">
                                    Edit Package
                                </a>

                                <a class="map-pill"
                                   asp-controller="MenuOptions"
                                   asp-action="Create"
                                   asp-route-menuItemId="@item.Id">
                                    Add Feature
                                </a>

                                <a class="danger-button"
                                   asp-controller="MenuItems"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id">
                                    Delete
                                </a>
                            </div>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <span class="map-pill">
                                Admin View
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}