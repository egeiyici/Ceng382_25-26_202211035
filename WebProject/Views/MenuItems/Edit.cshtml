@model WebProject.Models.MenuItem

@{
    ViewData["Title"] = "Edit Catering Package";
}

<h1>Edit Catering Package</h1>

<div class="card-box">

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

       @if (Model.ImageData != null)
{
    <div style="margin-bottom:20px;">

        <p>
            <strong>Current Package Image</strong>
        </p>

        <img src="@Url.Action("Image", "MenuItems", new { id = Model.Id })"
             style="
                width:220px;
                height:140px;
                object-fit:cover;
                border-radius:14px;
                border:1px solid #ddd;
             " />

        <div style="margin-top:12px;">
            <label style="display:flex; align-items:center; gap:8px; font-weight:800;">
                <input type="checkbox"
                       name="removeImage"
                       value="true"
                       style="width:auto; margin:0;" />

                Remove current image
            </label>
        </div>
    </div>
}
        <div class="form-group-clean">
            <label asp-for="Name">
                Catering Package Name
            </label>

            <input asp-for="Name"
                   placeholder="Example: Wedding Catering Package" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group-clean">
            <label asp-for="Price">
                Base Package Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   placeholder="1000" />

            <span asp-validation-for="Price"
                  class="text-danger">
            </span>

            <small>
                This is the base price for the minimum number of people.
            </small>
        </div>

        <div class="form-group-clean">
            <label asp-for="MinimumPeople">
                Minimum People
            </label>

            <input asp-for="MinimumPeople"
                   type="number"
                   min="1"
                   placeholder="10" />

            <span asp-validation-for="MinimumPeople"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group-clean">
            <label asp-for="PricePerPerson">
                Extra Person Price
            </label>

            <input asp-for="PricePerPerson"
                   type="number"
                   step="0.01"
                   placeholder="100" />

            <span asp-validation-for="PricePerPerson"
                  class="text-danger">
            </span>

            <small>
                This price is discounted automatically for larger groups.
            </small>
        </div>

        <div class="form-group-clean">
            <label asp-for="Description">
                Package Description
            </label>

            <textarea asp-for="Description"
                      rows="5"
                      placeholder="Describe the catering package, included meals, drinks, service details, and event type."></textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group-clean">
            <label>
                Change Package Image
            </label>

            <input type="file"
                   name="imageFile"
                   accept="image/*" />
        </div>

        <button type="submit">
            Save Changes
        </button>

        <a class="action-link"
           asp-action="Index">
            Back to Packages
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}