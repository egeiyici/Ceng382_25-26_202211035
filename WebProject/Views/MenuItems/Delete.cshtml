@model WebProject.Models.MenuItem

@{
    ViewData["Title"] = "Delete Catering Package";
}

<h1>Delete Catering Package</h1>

<div class="card-box">
    <h3>Are you sure you want to delete this catering package?</h3>

    @if (Model.ImageData != null)
    {
        <img src="@Url.Action("Image", "MenuItems", new { id = Model.Id })"
             style="width:220px; height:140px; object-fit:cover; border-radius:14px; margin:15px 0;" />
    }

    <p><strong>Package Name:</strong> @Model.Name</p>
    <p><strong>Package Price:</strong> @Model.Price.ToString("0.00") ₺</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Catering Company:</strong> @Model.Caretaker?.Email</p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="danger-button">
            Delete Package
        </button>

        <a class="action-link" asp-action="Index">
            Back to Packages
        </a>
    </form>
</div>