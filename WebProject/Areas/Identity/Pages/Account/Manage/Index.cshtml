@page
@model IndexModel

@{
    ViewData["Title"] = "Company Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card-box">
    <form id="profile-form"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"
             role="alert">
        </div>

        <div class="form-group-clean">
            <label asp-for="Username">Username</label>

            <input asp-for="Username"
                   class="form-control"
                   placeholder="Your username"
                   disabled />
        </div>

        <div class="form-group-clean">
            <label asp-for="Input.FullName">
                Full Name / Company Name
            </label>

            <input asp-for="Input.FullName"
                   class="form-control"
                   placeholder="Example: Prime Table Catering" />

            <span asp-validation-for="Input.FullName"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group-clean">
            <label asp-for="Input.PhoneNumber">
                Phone Number
            </label>

            <input asp-for="Input.PhoneNumber"
                   class="form-control"
                   placeholder="Please enter your phone number." />

            <span asp-validation-for="Input.PhoneNumber"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group-clean">
            <label>
                Profile / Company Image
            </label>

            @if (Model.HasProfileImage)
            {
                <div style="margin-bottom:15px;">
                    <img src="?handler=ProfileImage"
                         style="
                            width:160px;
                            height:110px;
                            object-fit:cover;
                            border-radius:14px;
                            border:1px solid #ddd;
                         " />
                </div>

                <label style="display:flex; align-items:center; gap:8px; font-weight:800;">
                    <input type="checkbox"
                           asp-for="Input.RemoveProfileImage"
                           style="width:auto; margin:0;" />

                    Remove current image
                </label>
            }

            <input asp-for="Input.ProfileImage"
                   type="file"
                   accept="image/*"
                   class="form-control" />

            <span asp-validation-for="Input.ProfileImage"
                  class="text-danger">
            </span>
        </div>

        <button id="update-profile-button"
                type="submit"
                class="btn btn-lg btn-primary">
            Save Profile
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}